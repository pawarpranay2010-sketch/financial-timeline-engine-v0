# Platrixa Termux worker — ONE INSTANCE's service environment (S2 + M7/M8).
#
# Install to: ~/.platrixa/worker-<instance>.env   (chmod 600)
# (The legacy single-instance path ~/.platrixa/worker.env still works when
#  PLATRIXA_WORKER_INSTANCE is unset or "default".)
#
# ONE INSTANCE = ONE TENANT. The API KEY IS NOT HERE. It lives in
# ~/.platrixa/worker-<instance>.key (chmod 600) and is read by the worker from
# that file; never put it in this file, and never let two instances share one.

# Hosted Platrixa API origin. Must be https (plain http is allowed only for
# loopback development).
PLATRIXA_API_BASE_URL=https://financial-timeline-engine-v0-production.up.railway.app

# Bounded lease-owner label. MUST be unique per instance: two instances sharing
# an id makes "which worker holds this job" unanswerable in diagnostics.
PLATRIXA_WORKER_ID=android-worker-alice

# The phone's OWN llama.cpp-compatible server. Loopback only, never a tunnel.
PLATRIXA_WORKER_MODEL_URL=http://127.0.0.1:11434

# The model id the local server advertises at GET /v1/models. Verify with:
#   curl -s http://127.0.0.1:11434/v1/models
PLATRIXA_WORKER_MODEL_ID=default

# "chat" posts /v1/chat/completions; "completion" posts /v1/completions with
# the exact Phase-H SFT framing.
PLATRIXA_WORKER_MODEL_DIALECT=chat

# Seconds to wait for one local generation.
PLATRIXA_WORKER_MODEL_TIMEOUT_S=120

# --- device-wide concurrency (M8) -------------------------------------------
# ALL instances share this directory. The cap is per PHONE, not per worker:
#   PLATRIXA_SLOT_MAX=1  -> exactly one generation at a time on this device
# Raising it is an on-device MEASUREMENT decision, not a tuning knob. Until the
# capacity test proves a higher value safe, leave it at 1.
PLATRIXA_SLOT_MAX=1
# Seconds to wait for a slot before the job is reported as a retryable failure
# (it goes to RETRY_WAIT, keeps its queue slot, and is not lost).
PLATRIXA_SLOT_WAIT_S=5

# --- optional service tuning -------------------------------------------------
# Directory holding the cloned repository (the directory that contains scripts/).
# PLATRIXA_REPO_DIR=/data/data/com.termux/files/home/platrixa

# python to run (default: $PREFIX/bin/python).
# PLATRIXA_PYTHON=/data/data/com.termux/files/usr/bin/python

# Model-readiness wait performed by the runit run script before it starts the
# worker: attempts x interval seconds. Default 60 x 2s = 2 minutes.
# PLATRIXA_READINESS_ATTEMPTS=60
# PLATRIXA_READINESS_INTERVAL=2

# Restart backoff applied by `finish` after an unclean exit.
# PLATRIXA_RESTART_BACKOFF_S=10

# Shared limiter directory (must be identical across every instance).
# PLATRIXA_SLOT_DIR=$HOME/.platrixa/slots
