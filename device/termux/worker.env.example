# Platrixa Termux worker — service environment (S2).
#
# Install to: ~/.platrixa/worker.env   (chmod 600)
# The API KEY IS NOT HERE. It lives in ~/.platrixa/worker.key (chmod 600) and
# is read by the worker from that file; never put it in this file.

# Hosted Platrixa API origin. Must be https (plain http is allowed only for
# loopback development).
PLATRIXA_API_BASE_URL=https://financial-timeline-engine-v0-production.up.railway.app

# Bounded lease-owner label. One stable value per device; do not run two
# workers with the same id.
PLATRIXA_WORKER_ID=android-test-worker

# The phone's OWN llama.cpp-compatible server. Loopback only, never a tunnel.
PLATRIXA_WORKER_MODEL_URL=http://127.0.0.1:11434

# The model id the local server advertises at GET /v1/models. Verify with:
#   curl -s http://127.0.0.1:11434/v1/models
PLATRIXA_WORKER_MODEL_ID=default

# "chat" posts /v1/chat/completions; "completion" posts /v1/completions with
# the exact Phase-H SFT framing.
PLATRIXA_WORKER_MODEL_DIALECT=chat

# Seconds to wait for one local generation.
PLATRIXA_WORKER_MODEL_TIMEOUT_S=120

# --- optional service tuning -------------------------------------------------
# Directory holding the cloned repository (the directory that contains scripts/).
# PLATRIXA_REPO_DIR=/data/data/com.termux/files/home/platrixa

# python to run (default: $PREFIX/bin/python).
# PLATRIXA_PYTHON=/data/data/com.termux/files/usr/bin/python

# Model-readiness wait performed by the runit run script before it starts the
# worker: attempts x interval seconds. Default 60 x 2s = 2 minutes.
# PLATRIXA_READINESS_ATTEMPTS=60
# PLATRIXA_READINESS_INTERVAL=2

# Restart backoff applied by `finish` after an unclean exit.
# PLATRIXA_RESTART_BACKOFF_S=10
