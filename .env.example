# =============================================================================
# Financial Timeline Engine — Environment Variables Template
# =============================================================================
# Copy this file to `.env` (or export these in your shell / secrets manager)
# and fill in real values. NEVER commit `.env` or `.env.local` — they are
# gitignored. Real credentials are supplied at runtime only.
#
# All secrets are read from environment variables at runtime:
#   - backend/module4/key_manager.py  (market data providers)
#   - core/config.py                  (AI Executive providers)
#   - backend/gateway/                (AI provider adapters)
#   - backend/module4/database_manager.py (DATABASE_URL)
#   - backend/gateway/redis_quota.py  (REDIS_URL)
#
# Optional keys can be left empty — the app degrades gracefully and falls
# back to the next available provider. YFinance requires no API key.
# =============================================================================

# --- AI Executive providers (core/config.py -> provider_key_names) ---------
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
RAPIDAPI_KEY=
SAMBANOVA_API_KEY=
GITHUB_TOKEN=
CEREBRAS_API_KEY=
COHERE_API_KEY=

# --- Market data providers (backend/module4/key_manager.py) ----------------
# Financial Modeling Prep (primary/rotating keys)
FMP_API_KEY=
FMP_API_KEY_2=
FMP_API_KEY_3=
# Alpha Vantage (primary/rotating keys)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_API_KEY_2=
# Finnhub
FINNHUB_API_KEY=
# Polygon.io (primary/rotating keys)
POLYGON_API_KEY=
POLYGON_API_KEY_2=

# --- Infrastructure --------------------------------------------------------
# PostgreSQL connection string, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Redis connection string (optional — falls back to in-memory state)
REDIS_URL=
# Live market intelligence scaffold key
MARKET_INTEL_API_KEY=
