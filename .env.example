# =============================================================================
# Financial Timeline Engine — Environment Variables Template
# =============================================================================
# Copy this file to `.env` (or export these in your shell / secrets manager)
# and fill in real values. NEVER commit `.env` or `.env.local` — they are
# gitignored. Real credentials are supplied at runtime only.
#
# All secrets are read from environment variables at runtime:
#   - backend/module4/key_manager.py  (market data providers)
#   - core/config.py                  (AI Executive providers)
#   - backend/gateway/                (AI provider adapters)
#   - backend/module4/database_manager.py (DATABASE_URL)
#   - backend/gateway/redis_quota.py  (REDIS_URL)
#
# Optional keys can be left empty — the app degrades gracefully and falls
# back to the next available provider. YFinance requires no API key.
# =============================================================================

# --- AI Executive providers (core/config.py -> provider_key_names) ---------
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
RAPIDAPI_KEY=
SAMBANOVA_API_KEY=
GITHUB_TOKEN=
CEREBRAS_API_KEY=
COHERE_API_KEY=

# --- Market data providers (backend/module4/key_manager.py) ----------------
# Financial Modeling Prep (primary/rotating keys)
FMP_API_KEY=
FMP_API_KEY_2=
FMP_API_KEY_3=
# Alpha Vantage (primary/rotating keys)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_API_KEY_2=
# Finnhub
FINNHUB_API_KEY=
# Polygon.io (primary/rotating keys)
POLYGON_API_KEY=
POLYGON_API_KEY_2=

# --- Infrastructure --------------------------------------------------------
# PostgreSQL connection string, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Redis connection string (optional — falls back to in-memory state)
REDIS_URL=
# Live market intelligence scaffold key
MARKET_INTEL_API_KEY=

# --- Developer onboarding (self-service API access) -----------------------
# Store: reuse the metering database (same credentials as platrixa_* tables)
PLATRIXA_METERING_DATABASE_URL=
# Required to issue keys: 32+ random characters, server-side only. No default.
PLATRIXA_KEY_DELIVERY_SECRET=
# Secret versioning for already-emailed one-time links. Bump the version when
# you rotate PLATRIXA_KEY_DELIVERY_SECRET and keep the OLD value in
# ..._PREVIOUS until every outstanding key delivery has been revealed.
PLATRIXA_KEY_DELIVERY_SECRET_VERSION=2
PLATRIXA_KEY_DELIVERY_SECRET_PREVIOUS=
PLATRIXA_ONBOARDING_ENABLED=1
PLATRIXA_ONBOARDING_INITIAL_QUOTA=50
PLATRIXA_PUBLIC_ORIGIN=
PLATRIXA_API_BASE_URL=
PLATRIXA_OWNER_NOTIFICATION_EMAIL=

# Email transport: smtp | none  (none = queued as EMAIL_NOT_CONFIGURED)
# Nothing is sent inside a request: the durable dispatcher below delivers.
#   python -m backend.onboarding.dispatcher --interval 30
#   (or POST /v1/internal/onboarding/dispatch with the token below)
PLATRIXA_EMAIL_PROVIDER=none
# Shared secret for the operational dispatch/health endpoints. Unset = those
# endpoints answer 404 (they simply do not exist).
PLATRIXA_ONBOARDING_DISPATCH_TOKEN=
# Lease held by one dispatcher while it owns a notification, in seconds.
# A crashed worker's lease expires and the row is recovered automatically.
PLATRIXA_ONBOARDING_DISPATCH_LEASE_SECONDS=120
# DEV/TEST ONLY. The runtime never runs DDL; the schema is applied by
#   python -m backend.auth.init_onboarding
# and checked read-only with --verify. Set to 1 only in throwaway stores.
PLATRIXA_ONBOARDING_AUTO_MIGRATE=0
PLATRIXA_SMTP_HOST=
PLATRIXA_SMTP_PORT=587
PLATRIXA_SMTP_USERNAME=
PLATRIXA_SMTP_PASSWORD=
PLATRIXA_SMTP_STARTTLS=1
PLATRIXA_SMTP_SSL=0
PLATRIXA_EMAIL_FROM=
PLATRIXA_EMAIL_FROM_NAME=Platrixa
PLATRIXA_EMAIL_REPLY_TO=

# Owner dashboard (deferred UI; APIs used by the management plane)
PLATRIXA_OWNER_DASHBOARD_USER=
PLATRIXA_OWNER_DASHBOARD_PASSWORD=

# --- Rate limiting / client identity behind the CDN ------------------------
# The backend must not trust caller-supplied X-Forwarded-For. Choose ONE:
#   * PLATRIXA_CLIENT_IP_HEADER: an edge-written header. Only these names are
#     honoured: cf-connecting-ip, x-real-ip, true-client-ip, fly-client-ip.
#   * PLATRIXA_TRUSTED_PROXY_COUNT: the number of proxies you operate in front
#     of the API; the client is read that many entries from the RIGHT of
#     X-Forwarded-For and leftmost (caller-supplied) values are ignored.
# With neither set, per-client caps fall back to the socket peer address.
PLATRIXA_CLIENT_IP_HEADER=
PLATRIXA_TRUSTED_PROXY_COUNT=0
# DEV/TEST ONLY: permit SMTP AUTH over a plaintext socket (local test relay).
# Production refuses to send a password without STARTTLS or implicit TLS.
PLATRIXA_SMTP_ALLOW_PLAINTEXT_AUTH=0
